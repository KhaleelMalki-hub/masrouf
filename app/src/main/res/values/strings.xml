    <!--
      Arabic counts in more forms than English, and "2 عملية" is ungrammatical to a
      native reader - the dual is عمليتان. The argument is still passed as %s and
      already converted, so the numeral itself stays Western and matches the amounts
      on the same screen.
    -->
    <plurals name="pending_count">
