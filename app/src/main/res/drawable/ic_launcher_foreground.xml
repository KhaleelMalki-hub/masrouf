<?xml version="1.0" encoding="utf-8"?>
<!--
  A receipt, drawn as one path with its two lines cut out as holes.

  One path and one colour on purpose: the same drawable is used as the themed
  monochrome layer on Android 13+, where the system recolours it wholesale. A mark
  built from several tinted pieces looks deliberate in the launcher and becomes a
  flat silhouette there, which is how an icon ends up unrecognisable on exactly the
  devices that theme it.

  The 108dp canvas is mostly bleed: an adaptive icon is masked to whatever shape
  the launcher prefers, and only the middle 66dp is guaranteed visible. The receipt
  spans 32-76, comfortably inside that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M34,29 h40 a3,3 0 0 1 3,3 v41 l-6.67,5.5 l-6.67,-5.5 l-6.66,5.5 l-6.67,-5.5 l-6.67,5.5 l-6.66,-5.5 v-41 a3,3 0 0 1 3,-3 z M42,42 h24 a2.5,2.5 0 0 1 0,5 h-24 a2.5,2.5 0 0 1 0,-5 z M42,54 h16 a2.5,2.5 0 0 1 0,5 h-16 a2.5,2.5 0 0 1 0,-5 z" />
</vector>
